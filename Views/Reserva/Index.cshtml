<h1>Lista de reservas</h1>
<p>Bienvenidos a la seleccion de reservas</p>
 @model Reserva

 <p>id:@Model.Id</p>
 <p>inquilino:@Model.inquilino</p>
 <p>inmueble: @Model.inmueble</p>
