<h1>Lista de propietarios</h1>
<p>Bienvenidos a la seleccion de propietarios</p>

@model List<inmobiliariaPrueva1.Models.Propietario>
<h1> Propietarios</h1>
@foreach (var propietario in Model){
<div>
    <p>Dni:@propietario.Dni</p>
    <p>nombre:@propietario.Nombres</p>
    <p>apellido:@propietario.Apellido</p>
    <p>telefono:@propietario.Telefono</p>
    <p>email:@propietario.Email</p>
</div>

}
