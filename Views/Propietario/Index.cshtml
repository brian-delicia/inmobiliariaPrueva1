
@if(TempData["Mensaje"]!=null){
    <div class="alert alert-success">
        @TempData["Mensaje"]
    </div>
}
@model List<inmobiliariaPrueva1.Models.Propietario>

@{
    ViewData["Title"]="Propietarios";

}

<div class="container mt-4">

    <div class="d-flex justify-content-between alingn-items-center mb-3">
        <h1>Propietarios</h1>
         <div>
        <a asp-action="Bajas" class="btn btn-secondary">
            Ver dados de baja
        </a>

        <a asp-action="Create" class="btn btn-primary">Nuevo propietario</a>
    </div>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-bordered table-hover">

            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>DNI</th>
                    <th>NOMBRE</th>
                    <th>APELLIDO</th>
                    <th>TELEFONO</th>
                    <th>EMAIL</th>
                    <th>ACCIONES</th>

                </tr>
            </thead>

            <tbody>
             @foreach (var propietario in Model){

                <tr>
                    <td>@propietario.IdPropietario</td>
                    <td>@propietario.Dni</td>
                    <td>@propietario.Nombre</td>
                    <td>@propietario.Apellido</td>
                    <td>@propietario.Telefono</td>
                    <td>@propietario.Email</td>

                    <td>
                    <a asp-action="Edit" asp-route-id="@propietario.IdPropietario" 
                    class="btn btn-warning btn-sm">Editar</a>

                    <a asp-action="Baja" 
                    asp-route-id="@propietario.IdPropietario"
                    class="btn btn-danger btn-sm">Baja</a>        
                    </td>
                </tr>
             }
            </tbody>
        </table>


    </div>



</div>
