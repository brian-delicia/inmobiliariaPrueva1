

@model inmobiliariaPrueva1.Models.Propietario

<h1>Editar propietario</h1>
<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="IdPropietario" />
    <div>
        <label asp-for="Dni"></label>
        <input asp-for="Dni">
        <span asp-validation-for="Dni"></span>
    </div>

    <div>
        <label asp-for="Nombre"></label>
        <input asp-for="Nombre">
        <span asp-validation-for="Nombre"></span>

    </div>

    <div>
        <label asp-for="Apellido"></label>
        <input asp-for="Apellido">
        <span asp-validation-for="Apellido"></span>

    </div>

    <div>
        <label asp-for="Telefono"></label>
        <input asp-for="Telefono">
        <span asp-validation-for="Telefono" ></span>
    </div>

    <div>
        <label asp-for="Email"></label>
        <input asp-for="Email">
        <span asp-validation-for="Email"></span>
    </div>

    <button type="submit">Guarda cambios</button>




</form>