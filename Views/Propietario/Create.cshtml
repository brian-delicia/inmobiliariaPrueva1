@model inmobiliariaPrueva1.Models.Propietario

<h1>Nuevo propietario</h1>



<form asp-action="Create" method="post">
<div>
    <label >Dni</label>
    <input asp-for="Dni">
    <span asp-validation-for="Dni"></span>
</div>
<div>
    <label >Nombre</label>
    <input asp-for="Nombre">
    <span asp-validation-for="Nombre"></span>
</div>
<div>
    <label >Apellido</label>
    <input asp-for="Apellido">
    <span asp-validation-for="Apellido"></span>
</div>
<div>
    <label >Telefono</label>
    <input asp-for="Telefono">
    <span asp-validation-for="Telefono"></span>
</div>
<div>
    <label >Email</label>
    <input asp-for="Email">
    <span asp-validation-for="Email"></span>
</div>

<button type="submit">Guardar</button>

</form>