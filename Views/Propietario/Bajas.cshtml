@model List<inmobiliariaPrueva1.Models.Propietario>

@{
ViewData["Title"] = "Propietarios dados de baja";
}

<div class="container mt-4">

<div class="d-flex justify-content-between align-items-center mb-3">

    <h1>Propietarios dados de baja</h1>

    <a asp-action="Index" class="btn btn-secondary">
        Volver
    </a>

</div>

<div class="table-responsive">

    <table class="table table-striped table-bordered">

        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>DNI</th>
                <th>NOMBRE</th>
                <th>APELLIDO</th>
                <th>TELEFONO</th>
                <th>EMAIL</th>
                <th>ACCIONES</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var propietario in Model)
            {
                <tr>

                    <td>@propietario.IdPropietario</td>
                    <td>@propietario.Dni</td>
                    <td>@propietario.Nombre</td>
                    <td>@propietario.Apellido</td>
                    <td>@propietario.Telefono</td>
                    <td>@propietario.Email</td>

                    <td>

                        <form asp-action="Reactivar"
                              method="post">

                            <input type="hidden"
                                   name="idPropietario"
                                   value="@propietario.IdPropietario" />

                            <button type="submit"
                                    class="btn btn-success btn-sm">
                                Reactivar
                            </button>

                        </form>

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>

</div>