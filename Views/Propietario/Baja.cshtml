@model inmobiliariaPrueva1.Models.Propietario

@{
    ViewData["Title"]="Dar de baja propietario";
}

<div class="container mt-5">

    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-danger text-white text center">
                    <h4 class="mb-0"> Dar de baja propietario</h4>
                </div>
                <div class="card-body">
                    <div class="text-center mb-4">
                        <h5>¿Esta seguro que quiere dar de baja este propietario?</h5>

                        <p class="text-muted">
                            El propietario no se eliminara de la base de datos
                            su estado pasara a inactivo
                        </p>
                    </div>
                    <div class="border rounded p-3 mb-4">
                        <p>
                            <strong>ID:</strong>
                            @Model.IdPropietario
                        </p>
                        <p>
                            <strong>DNI:</strong>
                            @Model.Dni
                        </p>
                        <p>
                            <strong>NOMBRE:</strong>
                            @Model.Nombre
                        </p>
                        <p>
                            <strong>APELLIDO:</strong>
                            @Model.Apellido
                        </p>
                        <p>
                            <strong>TELEFONO:</strong>
                            @Model.Telefono
                        </p>
                        <p class="mb-0">
                            <strong>EMAIL:</strong>
                            @Model.Email
                        </p>
                    </div>
                    <div class="d-flex justify-content-center gap-2">
                        <a asp-action="Index" class="btn btn-secondary"> Canselar</a>
                       
                        <form asp-action="DarDeBaja" method="post">
                            <input type="hidden" name="idPropietario" value="@Model.IdPropietario">
                            <button type="submit" class="btn btn-danger">Confirmar</button>
                        </form>
                    </div>

                </div>

            </div>

        </div>

    </div>

</div>