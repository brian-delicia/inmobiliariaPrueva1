<h1>Lista de inmuebles</h1>

<p>Bienvenidos a la seleccion de inmuebles</p>


@model Inmueble
<h1>datos del nmueble</h1>
<p>Id:@Model.Id</p>
<p>Direccion:@Model.Direccion</p>
<p>Capasidad:@Model.Capasidad</p>
<p>Tipo inmueble:@Model.Tipo</p>
<p>Cordenadas:@Model.Cordenadas</p>
<p>Precio del alquiler:@Model.PrecioAlquiler</p>
<p>Estado:@Model.Estado</p>